;; Data
(defpoll day  :interval "60s" `LANG=C date +%A | tr '[:lower:]' '[:upper:]' | sed 's/./&  /g' | sed 's/  $//'`)
(defpoll date :interval "60s" `date '+%B %d %Y' | tr '[:lower:]' '[:upper:]'`)
(defpoll time :interval "1s"  `date '+%I:%M %p'`)

;; Widget
(defwidget clock []
  (box :orientation "vertical"
       :halign "center"
       :space-evenly false
    (label :class "day"  :text day)
    (label :class "date" :text date)
    (label :class "time" :text time)))

;; Window
(defwindow clock
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "60px"
                      :width "1600px"
                      :anchor "top center")
  :stacking "bg"
  :exclusive false
  :focusable false
  (clock))